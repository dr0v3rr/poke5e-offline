############################################################
# poke5e-offline configuration
#
# Copy to .env (scripts/setup.sh does this for you) and edit.
# The defaults below WORK OUT OF THE BOX for local use at
# http://localhost:9000 . Change the secrets before exposing
# this to anything other than your own machine / LAN.
############################################################

# ---- Where poke5e's source comes from -------------------
# The frontend, edge function, and DB migrations are all pulled
# from this repo at setup/update time (nothing is vendored here).
POKE5E_REPO=https://github.com/Auroratide/poke5e.git
# Branch, tag, or commit SHA to build. Pinned to a verified commit so a fresh
# clone always builds without error; set to `main` (then run update.sh) to track latest.
POKE5E_REF=9eb2ca80d07c3e1079ab50a19db59c281ba249da

# ---- Public address of the whole app --------------------
# This is the ONE origin everything is served from (frontend +
# Supabase API + user assets). It is baked into the frontend at
# BUILD time and used to presign asset uploads, so it must match
# the address your browser actually uses.
#   - Same machine only:  http://localhost:9000
#   - Over your LAN:       http://192.168.x.y:9000  (then re-run scripts/update.sh)
APP_ORIGIN=http://localhost:9000
# Host port the gateway listens on (bound to 0.0.0.0 -> all interfaces).
APP_PORT=9000

# ---- Secrets (CHANGE THESE for anything non-local) -------
# Rotate all three together with:  sh scripts/generate-keys.sh --update-env
POSTGRES_PASSWORD=poke5e-offline-postgres-change-me
JWT_SECRET=poke5e-offline-super-secret-jwt-key-change-me-32c
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InBva2U1ZS1vZmZsaW5lIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjI1MDAwMDAwMDB9.6bFUljDu_xNmRYHxpxFkUycLy_pnFAPFNOLeLG-D674
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoicG9rZTVlLW9mZmxpbmUiLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6MjUwMDAwMDAwMH0.j2R8gBwauqUQ241cQupt6oCWuwNRW6IrXuND8k6D0MM
JWT_EXPIRY=3600

# ---- MinIO (S3-compatible user-asset storage) -----------
MINIO_ROOT_USER=eevee
MINIO_ROOT_PASSWORD=glaceon-espeon-change-me
MINIO_REGION=auto
# Optional: expose the MinIO admin console on the host (browse at :9001)
MINIO_CONSOLE_PORT=9001

# ---- Storage-api S3 protocol endpoint creds -------------
# Only used by storage-api's internal S3 protocol endpoint; not
# exposed. Any random hex values are fine.
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907

# ---- Postgres wiring (rarely need to change) ------------
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ---- PostgREST ------------------------------------------
PGRST_DB_SCHEMAS=public,graphql_public
